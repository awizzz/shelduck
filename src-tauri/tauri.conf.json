{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelduck",
  "version": "3.0.0",
  "identifier": "dev.awizz.shelduck",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Shelduck",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "A good-looking terminal for Windows with Linux commands built in",
    "longDescription": "Shelduck comes with its own Linux-style command interpreter and also runs PowerShell, Command Prompt, Git Bash and WSL, with tabs, split panes and live visual customization.",
    "externalBin": [
      "binaries/shelduck-sh"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "9376f157-2ec5-5351-8618-b47df78869c9",
        "fragmentPaths": [
          "windows/launchers.wxs"
        ],
        "componentRefs": [
          "LauncherCleanup"
        ]
      }
    }
  }
}
