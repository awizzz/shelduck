<?xml version="1.0" encoding="utf-8"?>
<!-- The app adds "Open in Shelduck" and its administrator entry to File
     Explorer, and the shelduck command to the user's PATH, itself (launcher.rs).
     This only removes them when the app is uninstalled, not when an update replaces it. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Before 3.0 the app was Nebula Terminal. Its installer keeps its shortcuts through
         an update, so they would stay next to Shelduck's: this one takes them away. -->
    <Property Id="FORMERINSTALLDIR">
      <RegistrySearch Id="FormerInstallDir" Root="HKCU" Key="Software\awizz\Nebula Terminal" Name="InstallDir" Type="raw" />
    </Property>
    <DirectoryRef Id="ProgramMenuFolder">
      <Directory Id="FormerProgramsFolder" Name="Nebula Terminal" />
    </DirectoryRef>

    <!-- Through an update, Tauri only puts the desktop shortcut back when one named after
         the app is still there. Coming from Nebula Terminal, the one to look for has its name. -->
    <Property Id="FORMERDESKTOPSHORTCUT" Secure="yes">
      <DirectorySearch Id="FormerDesktopShortcutSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Id="FormerDesktopShortcutFile" Name="Nebula Terminal.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="DESKTOPSHORTCUTEXISTS" Value="1" After="AppSearch" Sequence="both">FORMERDESKTOPSHORTCUT</SetProperty>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="LauncherCleanup" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Shelduck" Name="Launcher Cleanup" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFile Id="FormerStartMenuShortcut" Directory="FormerProgramsFolder" Name="Nebula Terminal.lnk" On="install" />
        <RemoveFolder Id="FormerProgramsFolder" Directory="FormerProgramsFolder" On="install" />
        <RemoveFile Id="FormerDesktopShortcut" Directory="DesktopFolder" Name="Nebula Terminal.lnk" On="install" />
        <RemoveFile Id="FormerUninstallShortcut" Property="FORMERINSTALLDIR" Name="Uninstall Nebula Terminal.lnk" On="install" />
        <RemoveFolder Id="FormerInstallFolder" Property="FORMERINSTALLDIR" On="install" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Shelduck" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Shelduck" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\Shelduck" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\ShelduckAdmin" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\ShelduckAdmin" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\ShelduckAdmin" Action="removeOnUninstall" />
      </Component>
    </DirectoryRef>

    <!-- Runs the app's own cleanup (launcher.rs) while its files are still there. -->
    <CustomAction Id="LauncherUninstall" FileKey="Path" ExeCommand="--uninstall" Execute="immediate" Return="ignore" />
    <!-- Windows caches the icons of shortcuts and pinned apps, so the taskbar can keep an
         old icon after an update. ie4uinit rebuilds that cache for the user installing. -->
    <CustomAction Id="RefreshIcons" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]ie4uinit.exe&quot; -show" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LauncherUninstall" Before="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RefreshIcons" After="InstallFinalize">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
